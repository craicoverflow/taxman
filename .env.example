# Copy to .env (gitignored) and fill in. `make dev` loads and exports these.

# Optional: free API key from https://finnhub.io — used first for the
# portfolio page's live prices, ahead of the keyless Yahoo/stooq
# endpoints (which are rate-limited or IP-blocked on some networks).
# Only the ticker symbol and this token are ever sent out.
TAXMAN_FINNHUB_TOKEN=

# Optional tax-rate overrides (fractions, e.g. 0.38). Usually leave unset.
# TAXMAN_CGT_RATE=
# TAXMAN_EXIT_TAX_RATE=
# TAXMAN_DIRT_RATE=
